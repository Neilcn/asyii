{%- liquid
  assign s = section.settings
  assign gblog = blogs[s.blog]
  assign shown = 0
-%}

<div class="asyii-gg section section--{{ s.section_width }}" style="--gg-pt: {{ s['padding-block-start'] }}px; --gg-pb: {{ s['padding-block-end'] }}px;">
  <div class="asyii-gg__inner">
    <div class="asyii-gg__head">
      {%- if s.kicker != blank -%}
        <p class="asyii-gg__kicker">{{ s.kicker }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="asyii-gg__title">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.link_label != blank and s.link_url != blank -%}
        <a class="asyii-gg__all" href="{{ s.link_url }}">{{ s.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if gblog != blank and gblog.articles_count > 0 -%}
      <div class="asyii-gg__grid">
        {%- for article in gblog.articles -%}
          {%- if article.tags contains s.tag and shown < s.post_limit -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="asyii-gg__card" href="{{ article.url }}">
              <span class="asyii-gg__card-date">{{ article.published_at | date: '%b %Y' }}</span>
              <span class="asyii-gg__card-title">{{ article.title }}</span>
              <span class="asyii-gg__card-dek">{{ article.excerpt_or_content | strip_html | truncate: 118 }}</span>
              <span class="asyii-gg__card-cta">{{ s.card_cta | default: 'Read the guide' }} &rarr;</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if shown == 0 -%}
        <p class="asyii-gg__empty">No guides tagged “{{ s.tag }}” yet.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<style>
  .asyii-gg { padding-block: var(--gg-pt, 48px) var(--gg-pb, 48px); }
  .asyii-gg__inner { width: 100%; }
  .asyii-gg__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-block-end: 22px; }
  .asyii-gg__kicker { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: .6; margin: 0 0 6px; }
  .asyii-gg__title { font-size: 1.5rem; margin: 0; }
  .asyii-gg__all { font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; white-space: nowrap; }
  .asyii-gg__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 32px; }
  .asyii-gg__card { display: block; text-decoration: none; color: inherit; border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / .14); padding: 18px 0 22px; }
  .asyii-gg__card:hover .asyii-gg__card-title { opacity: .72; }
  .asyii-gg__card-date { display: block; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .55; margin-bottom: 8px; }
  .asyii-gg__card-title { display: block; font-size: 1.06rem; line-height: 1.35; margin-bottom: 8px; transition: opacity .2s ease; }
  .asyii-gg__card-dek { display: block; font-size: .88rem; line-height: 1.55; opacity: .72; margin-bottom: 12px; }
  .asyii-gg__card-cta { display: inline-block; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .asyii-gg__empty { font-size: .9rem; opacity: .6; }
  @media (max-width: 899px) {
    .asyii-gg__grid { grid-template-columns: repeat(2, 1fr); gap: 0 20px; }
    .asyii-gg__title { font-size: 1.25rem; }
  }
  @media (max-width: 599px) {
    .asyii-gg__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Gift guides (by tag)",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift guides from the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "tag", "label": "Only posts tagged", "default": "Gifting & Occasions", "info": "Articles must carry this exact tag to appear." },
    { "type": "range", "id": "post_limit", "label": "Maximum posts", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "card_cta", "label": "Card link text", "default": "Read the guide" },
    { "type": "text", "id": "link_label", "label": "Header link text" },
    { "type": "url", "id": "link_url", "label": "Header link URL" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [ { "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" } ], "default": "page-width" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 48 }
  ],
  "presets": [ { "name": "Gift guides (by tag)" } ]
}
{% endschema %}
