{%- comment -%} ASYII structured data (JSON-LD). Additive only — Dawn already emits Product/Article/Organization natively. This adds BreadcrumbList + review AggregateRating + WebSite search. {%- endcomment -%}
{%- comment -%} Build breadcrumb item objects {%- endcomment -%}
{%- assign _cr = '{"@type":"ListItem","position":1,"name":"Home","item":"' | append: shop.url | append: '/"}' -%}
{%- if request.page_type == 'product' -%}
  {%- if product.collections.first -%}
    {%- assign _cr = _cr | append: ',' | append: '{"@type":"ListItem","position":2,"name":' | append: product.collections.first.title | json | append: ',"item":"' | append: product.collections.first.url | prepend: shop.url | append: '"}' -%}
    {%- assign _pos = 3 -%}
  {%- else -%}
    {%- assign _pos = 2 -%}
  {%- endif -%}
  {%- assign _cr = _cr | append: ',' | append: '{"@type":"ListItem","position":' | append: _pos | append: ',"name":' | append: product.title | json | append: ',"item":"' | append: product.url | prepend: shop.url | append: '"}' -%}
{%- elsif request.page_type == 'article' -%}
  {%- assign _cr = _cr | append: ',' | append: '{"@type":"ListItem","position":2,"name":' | append: article.title | json | append: ',"item":"' | append: article.url | prepend: shop.url | append: '"}' -%}
{%- elsif request.page_type == 'collection' -%}
  {%- assign _cr = _cr | append: ',' | append: '{"@type":"ListItem","position":2,"name":' | append: collection.title | json | append: ',"item":"' | append: collection.url | prepend: shop.url | append: '"}' -%}
{%- endif -%}

{%- if request.page_type == 'product' or request.page_type == 'article' or request.page_type == 'collection' -%}
<script type="application/ld+json">
{ "@context":"https://schema.org", "@type":"BreadcrumbList", "itemListElement":[ {{ _cr }} ] }
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product.metafields.reviews.rating_count -%}
<script type="application/ld+json">
{ "@context":"https://schema.org", "@type":"Product", "@id":"{{ shop.url }}/#product-{{ product.id }}",
  "aggregateRating": { "@type":"AggregateRating", "ratingValue": {{ product.metafields.reviews.rating.value | json }}, "reviewCount": {{ product.metafields.reviews.rating_count | json }} } }
</script>
{%- endif -%}

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{ "@context":"https://schema.org", "@type":"WebSite", "name":"ASYII", "url":"{{ shop.url }}",
  "potentialAction": { "@type":"SearchAction", "target":"{{ shop.url }}/search?q={search_term_string}", "query-input":"required name=search_term_string" } }
</script>
{%- endif -%}
