{%- comment -%} ASYII structured data (JSON-LD). Additive only — Dawn already emits Product/Article/Organization natively. Adds BreadcrumbList + WebSite search. (AggregateRating now handled by Judge.me rich snippets.) {%- endcomment -%}

{%- if request.page_type == 'product' or request.page_type == 'article' or request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}/" }
    {%- if request.page_type == 'product' and product.collections.first -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ product.collections.first.title | json }}, "item": "{{ product.collections.first.url | prepend: shop.url }}" }
    {%- assign _bpos = 3 -%}
    {%- else -%}
    {%- assign _bpos = 2 -%}
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
    ,{ "@type": "ListItem", "position": {{ _bpos }}, "name": {{ product.title | json }}, "item": "{{ product.url | prepend: shop.url }}" }
    {%- elsif request.page_type == 'article' -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ article.title | json }}, "item": "{{ article.url | prepend: shop.url }}" }
    {%- elsif request.page_type == 'collection' -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ collection.url | prepend: shop.url }}" }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ASYII",
  "url": "{{ shop.url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}
