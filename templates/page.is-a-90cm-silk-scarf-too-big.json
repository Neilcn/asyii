        "custom_liquid": "<style>\n.shopguide{background:#fff;color:#111}\n.shopguide *{box-sizing:border-box}\n.shopguide .article{max-width:760px;margin:0 auto;padding:52px 24px 84px;font:16px/1.7 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.shopguide .kicker{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#767676;margin-bottom:14px}\n.shopguide h1{font-size:42px;line-height:1.12;letter-spacing:-.025em;font-weight:700;margin:0 0 16px;max-width:19ch}\n.shopguide .byline{font-size:12px;color:#767676;margin:0 0 22px;padding-bottom:22px;border-bottom:1px solid #e5e5e5}\n.shopguide .toc{font-size:13px;margin:0 0 34px}.shopguide .toc a{color:#111;text-decoration:none;border-bottom:1px solid #111;padding-bottom:2px}\n.shopguide .lead{font-size:17px;line-height:1.72;margin:0 0 18px}.shopguide .lead b{font-weight:700}\n.shopguide h2{font-size:27px;line-height:1.2;letter-spacing:-.015em;font-weight:700;margin:58px 0 18px;scroll-margin-top:24px}\n.shopguide .article p{margin:0 0 17px}\n.shopguide .products{display:grid;grid-template-columns:repeat(2,1fr);gap:26px;margin:24px 0 6px}\n.shopguide .product{border-bottom:1px solid #ececec;padding-bottom:20px;min-width:0}\n.shopguide .pimg{display:block}.shopguide .pimg img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#f6f6f6}\n.shopguide .pmeta{font-size:11px;text-transform:uppercase;letter-spacing:.06em;margin:12px 0 6px;color:#767676}\n.shopguide .off{color:#c00;margin-right:12px;font-weight:700}.shopguide .variant{color:#767676}\n.shopguide .pname{display:block;font-size:16px;font-weight:700;color:#111;text-decoration:none;line-height:1.3;margin:0 0 7px}\n.shopguide .ppick{font-size:13.5px;line-height:1.55;color:#333;margin:0 0 9px}.shopguide .ppick b{font-weight:700}\n.shopguide .pprice{font-size:14px;color:#333;margin:0 0 7px}.shopguide .pprice s{color:#999;margin-right:8px}.shopguide .pprice b{font-weight:700;color: