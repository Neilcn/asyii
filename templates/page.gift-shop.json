      "settings": {
        "custom_liquid": "{%- comment -%} ASYII Gifting — auto gift guide (tag: Gifting & Occasions) + static occasion cards. Preview v4. {%- endcomment -%}\n{%- assign gift_blog = blogs['asyii-diaries'] -%}\n{%- assign guide_count = 0 -%}\n<style>\n.asg{background:#faf9f6;color:#1a1a1a;font-family:'Plus Jakarta Sans',Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.asg *{box-sizing:border-box}\n.asg .wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n.asg .hero{text-align:center;padding:60px 20px 40px;background:#fff;border-bottom:1px solid #e6e2dc}\n.asg .eyebrow{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#6b6b6b;margin:0 0 16px}\n.asg .hero h1{font-size:44px;font-weight:600;letter-spacing:-.02em;margin:0 0 16px;line-height:1.1}\n.asg .hero p{font-size:15px;color:#6b6b6b;max-width:620px;margin:0 auto;line-height:1.8}\n.asg .hero .quote{font-size:14px;color:#8a7f70;font-style:italic;margin-top:18px}\n.asg .sec{padding:50px 0}\n.asg .sec h2{font-size:24px;font-weight:600;margin:0 0 6px}\n.asg .sec .sub{font-size:13px;color:#6b6b6b;margin:0 0 28px}\n.asg .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}\n.asg .occ{background:#fff;border:1px solid #e6e2dc;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}\n.asg .occ:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.07)}\n.asg .imgs{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:#e6e2dc;height:190px}\n.asg .imgs img{width:100%;height:100%;object-fit:cover;display:block;background:#f3f0ea}\n.asg .occ .body{padding:20px 24px 24px;flex:1;display:flex;flex-direction:column}\n.asg .occ h3{font-size:19px;font-weight:600;margin:0 0 8px}\n.asg .occ p{font-size:13px;color:#6b6b6b;line-height:1.7;margin:0 0 14px;flex:1}\n.asg .meta{font-size:11.5px;color:#8a7f70;margin-bottom:15px}\n.asg .btn{display:inline-block;align-self:flex-start;font-size:12.5px;font-weight:600;color:#fff;background:#1a1a1a;text-decoration:none;padding:10px 18px;border-radius:7px}\n.asg .pricebar{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\n.asg .pricebar a{text-align:center;border:1px solid #e6e2dc;border-radius:10px;padding:16px 12px;background:#fff;text-decoration:none;color:#1a1a1a}\n.asg .pricebar a b{display:block;font-size:16px;margin-bottom:3px}\n.asg .pricebar a span{font-size:11.5px;color:#6b6b6b}\n.asg .ggrid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}\n.asg .gcard{display:flex;flex-direction:column;background:#fff;border:1px solid #e6e2dc;border-radius:12px;padding:24px 26px;text-decoration:none;color:#1a1a1a;min-height:190px;transition:transform .2s,box-shadow .2s,border-color .2s}\n.asg .gcard:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.07);border-color:#cfc9bf}\n.asg .gcard .date{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:#9a8f80;margin-bottom:10px}\n.asg .gcard b{font-size:17px;font-weight:600;line-height:1.45;display:block;margin-bottom:10px}\n.asg .gcard p{font-size:12.5px;color:#6b6b6b;line-height:1.7;margin:0;flex:1}\n.asg .gcard .more{font-size:12px;font-weight:600;color:#1a1a1a;margin-top:16px;align-self:flex-start}\n.asg .gcard .more span{display:inline-block;transition:transform .2s}\n.asg .gcard:hover .more span{transform:translateX(4px)}\n.asg .empty{border:1px dashed #e6e2dc;border-radius:10px;padding:20px;color:#6b6b6b;font-size:13px;background:#fff}\n@media(max-width:749px){\n .asg .hero h1{font-size:32px}\n .asg .grid,.asg .ggrid{grid-template-columns:1fr}\n .asg .pricebar{grid-template-columns:repeat(2,1fr)}\n .asg .sec{padding:36px 0}\n}\n</style>\n\n<div class=\"asg\">\n  <div class=\"hero\">\n    <p class=\"eyebrow\">The ASYII Gift Shop</p>\n    <h1>Gifts chosen with<br>thought, not haste.</h1>\n    <p>A silk scarf is more than an accessory — it's a quiet hug, a story, a gesture that lasts. Find the perfect piece for every occasion, and for no occasion at all.</p>\n    <p class=\"quote\">\"Find the perfect piece for every occasion ♡\"</p>\n  </div>\n\n  <div class=\"wrap\">\n    <div class=\"sec\">\n      <h2>Shop by occasion</h2>\n      <p class=\"sub\">Four ways to give — each one a hand-finished edit, not a discount bin.</p>\n      <div class=\"grid\">\n\n        <div class=\"occ\">\n          <div class=\"imgs\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/f9607f34-asyii-printed-abstract-floral-silk-twill-square-sa180625-2-m03.webp?v=1772444601\" alt=\"Printed abstract floral silk twill square\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/6198ae50-asyii-printed-floral-silk-twill-square-butter-yellow-sa180625-3-m05.webp?v=1772444600\" alt=\"Printed floral silk twill square\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/2bb1c279-asyii-printed-floral-devore-silk-square-sa180625-4-m01.webp?v=1772615999\" alt=\"Printed floral devore silk square\">\n          </div>\n          <div class=\"body\">\n            <h3>For the Ones You Love</h3>\n            <p>No occasion needed. Just a little something to say \"I'm glad you're in my life.\"</p>\n            <div class=\"meta\">13 pieces · RRP £35–138</div>\n            <a class=\"btn\" href=\"/collections/for-the-ones-you-love\">Shop the edit →</a>\n          </div>\n        </div>\n\n        <div class=\"occ\">\n          <div class=\"imgs\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/9d2c044b-asyii-gift-to-self-silk-wool-square-scarf-sw140925-1-m01-e1769528572749.webp?v=1772444601\" alt=\"Gift to Self silk-wool square scarf\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/92b5a84b-asyii-sweet-prelude-silk-wool-long-wrap-sw140925-3-m01-e1769528199361.webp?v=1772444601\" alt=\"Sweet Prelude silk-wool long wrap\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/788809a1-asyii-gift-to-self-silk-puffy-scrunchie-aw140925-5-f01-e1769528542615.webp?v=1772444600\" alt=\"Gift to Self silk puffy scrunchie\">\n          </div>\n          <div class=\"body\">\n            <h3>For the Celebrations</h3>\n            <p>Birthdays, anniversaries, or just because. A piece that says \"I see you, I cherish you.\"</p>\n            <div class=\"meta\">10 pieces · RRP £35–145</div>\n            <a class=\"btn\" href=\"/collections/for-the-celebrations\">Shop the edit →</a>\n          </div>\n        </div>\n\n        <div class=\"occ\">\n          <div class=\"imgs\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/asyii-bloom-corner-double-face-silk-twill-scarf-ss161125-1-m05.webp?v=1776686144\" alt=\"Bloom Corner silk twill square\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/asyii-garden-veil-double-face-silk-square-scarf-ss161125-2-m01.webp?v=1776693999\" alt=\"Garden Veil silk square scarf\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/asyii-bow-laced-triangle-silk-scarf-ss161125-3-m03.webp?v=1776686025\" alt=\"Bow-Laced silk-cotton triangle scarf\">\n          </div>\n          <div class=\"body\">\n            <h3>For the Wedding Moments</h3>\n            <p>From the one saying \"yes\" to the ones standing beside her — softness for every role on the big day.</p>\n            <div class=\"meta\">10 pieces · RRP £35–138</div>\n            <a class=\"btn\" href=\"/collections/for-the-wedding-moments\">Shop the edit →</a>\n          </div>\n        </div>\n\n        <div class=\"occ\">\n          <div class=\"imgs\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/9d2c044b-asyii-gift-to-self-silk-wool-square-scarf-sw140925-1-m01-e1769528572749.webp?v=1772444601\" alt=\"Gift to Self silk-wool square scarf\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/788809a1-asyii-gift-to-self-silk-puffy-scrunchie-aw140925-5-f01-e1769528542615.webp?v=1772444600\" alt=\"Gift to Self silk puffy scrunchie\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0990/2207/8261/files/14399ce8-asyii-token-of-luck-silk-square-scrunchie-aw140925-4-f01-e1769528476665.webp?v=1772444601\" alt=\"Token of Luck silk square scrunchie\">\n          </div>\n          <div class=\"body\">\n            <h3>For the Little Treats</h3>\n            <p>The small, considered upgrades — a soft curl, a quiet morning, a little more calm. Because you don't need a reason.</p>\n            <div class=\"meta\">8 pieces · RRP £15–145</div>\n            <a class=\"btn\" href=\"/collections/for-the-little-treats\">Shop the edit →</a>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <div class=\"sec\" style=\"padding-top:0\">\n      <h2>Gift by price</h2>\n      <p class=\"sub\">Shown at RRP — hand-finished silk at every budget.</p>\n      <div class=\"pricebar\">\n        <a href=\"/collections/for-the-little-treats\"><b>Under £50</b><span>Scrunchies · twillies</span></a>\n        <a href=\"/collections/for-the-ones-you-love\"><b>£50–100</b><span>Silk squares · devoré</span></a>\n        <a href=\"/collections/for-the-celebrations\"><b>£100–150</b><span>Silk-wool · 90cm</span></a>\n        <a href=\"/collections/for-the-celebrations\"><b>£150+</b><span>The gift-box edit</span></a>\n      </div>\n    </div>\n\n    <div class=\"sec\" style=\"padding-top:0\">\n      <h2>Gift guides from the journal</h2>\n      {%- assign sorted_articles = gift_blog.articles | sort: 'published_at' | reverse -%}\n      {%- for article in sorted_articles -%}\n        {%- if article.tags contains 'Gifting & Occasions' and guide_count < 8 -%}\n          {%- if guide_count == 0 -%}<div class=\"ggrid\">{%- endif -%}\n          <a class=\"gcard\" href=\"{{ article.url }}\">\n            <span class=\"date\">{{ article.published_at | date: '%d %b %Y' }}</span>\n            <b>{{ article.title | escape }}</b>\n            <p>{{ article.excerpt | strip_html | strip | truncate: 150 }}</p>\n            <span class=\"more\">Read the story <span>→</span></span>\n          </a>\n          {%- assign guide_count = guide_count | plus: 1 -%}\n        {%- endif -%}\n      {%- endfor -%}\n      {%- if guide_count == 0 -%}\n      <div class=\"empty\">Gift guides are on their way.</div>\n      {%- else -%}\n      </div>\n      {%- endif -%}\n    </div>\n  </div>\n</div>\n"
      }
